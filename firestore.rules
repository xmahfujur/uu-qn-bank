rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to get user role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if the user is super admin
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)mr074770@gmail\\.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    // Helper function to check if the user is moderator or super admin
    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'banned'])) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesReceived'])
      );
      allow delete: if isAdmin();
    }

    // Departments, Batches, Semesters (Moderators & Super Admins can manage academic hierarchy)
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isModerator();
    }
    
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isModerator();
    }
    
    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'downloads', 'reportCount'])) ||
        (isAuthenticated() && (
          resource.data.uploadedByUID == request.auth.uid || 
          isModerator() || 
          // Allow updating views, downloads, likes, likedBy, bookmarks, and reports safely
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'downloads', 'likes', 'likedBy', 'bookmarks', 'reportCount']))
        ));
      allow delete: if isAuthenticated() && (resource.data.uploadedByUID == request.auth.uid || isModerator());
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuthenticated() && request.resource.data.reportedByUID == request.auth.uid;
      allow update, delete: if isModerator();
    }

    // Bookmarks and Likes
    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
    
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Faculties collection
    match /faculties/{facultyId} {
      allow read: if true;
      allow create, delete: if isModerator();
      allow update: if isModerator() || (
        isAuthenticated() &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.designation == resource.data.designation &&
        request.resource.data.departmentId == resource.data.departmentId &&
        (!resource.data.keys().hasAny(['imageUrl']) || request.resource.data.imageUrl == resource.data.imageUrl) &&
        (!resource.data.keys().hasAny(['phone']) || request.resource.data.phone == resource.data.phone) &&
        (!resource.data.keys().hasAny(['email']) || request.resource.data.email == resource.data.email)
      );
    }

    // Faculty ratings collection
    match /faculty_ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isModerator());
    }

    // Academic Events and Exam Countdown collection
    match /academic_events/{eventId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Audit logs collection (Moderators and Super Admins can read and create logs)
    match /audit_logs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update: if false; // Immutable audit trail
      allow delete: if isAdmin();
    }

    // Paper Images collection (Self-hosted resilient paper storage & backup)
    match /paper_images/{imageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isModerator();
    }

    // System Settings (Watermark, Storage configs)
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Daily Visitor Analytics (Moderators/Admins read; visitors may only atomically increment by +1)
    function isValidVisitorDateId(dateId) {
      return dateId is string && dateId.size() == 10 && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidVisitorStatCreate(data, dateId) {
      return data.keys().hasAll(['date', 'uniqueVisitors', 'totalVisits', 'updatedAt'])
        && data.keys().hasOnly(['date', 'uniqueVisitors', 'totalVisits', 'mobileVisits', 'desktopVisits', 'pwaVisits', 'updatedAt'])
        && data.date is string && data.date == dateId
        && data.uniqueVisitors is number && data.uniqueVisitors >= 0 && data.uniqueVisitors <= 1
        && data.totalVisits is number && data.totalVisits == 1
        && (!data.keys().hasAny(['mobileVisits']) || (data.mobileVisits is number && data.mobileVisits >= 0 && data.mobileVisits <= 1))
        && (!data.keys().hasAny(['desktopVisits']) || (data.desktopVisits is number && data.desktopVisits >= 0 && data.desktopVisits <= 1))
        && (!data.keys().hasAny(['pwaVisits']) || (data.pwaVisits is number && data.pwaVisits >= 0 && data.pwaVisits <= 1))
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidVisitorStatIncrement(incomingData, existingData, dateId) {
      let changed = incomingData.diff(existingData).affectedKeys();
      return changed.hasOnly(['date', 'uniqueVisitors', 'totalVisits', 'mobileVisits', 'desktopVisits', 'pwaVisits', 'updatedAt'])
        && incomingData.date is string && incomingData.date == dateId
        && incomingData.updatedAt is string && incomingData.updatedAt.size() <= 40
        && incomingData.totalVisits is number
        && existingData.totalVisits is number
        && incomingData.totalVisits >= existingData.totalVisits
        && incomingData.totalVisits <= existingData.totalVisits + 1
        && incomingData.uniqueVisitors is number
        && incomingData.uniqueVisitors >= existingData.get('uniqueVisitors', 0)
        && incomingData.uniqueVisitors <= existingData.get('uniqueVisitors', 0) + 1
        && (!changed.hasAny(['mobileVisits']) || (
          incomingData.mobileVisits is number
          && incomingData.mobileVisits >= existingData.get('mobileVisits', 0)
          && incomingData.mobileVisits <= existingData.get('mobileVisits', 0) + 1
        ))
        && (!changed.hasAny(['desktopVisits']) || (
          incomingData.desktopVisits is number
          && incomingData.desktopVisits >= existingData.get('desktopVisits', 0)
          && incomingData.desktopVisits <= existingData.get('desktopVisits', 0) + 1
        ))
        && (!changed.hasAny(['pwaVisits']) || (
          incomingData.pwaVisits is number
          && incomingData.pwaVisits >= existingData.get('pwaVisits', 0)
          && incomingData.pwaVisits <= existingData.get('pwaVisits', 0) + 1
        ));
    }

    match /visitor_stats/{dateId} {
      allow get: if isValidVisitorDateId(dateId) && isModerator();
      allow list: if isModerator();
      allow create: if isValidVisitorDateId(dateId) && isValidVisitorStatCreate(request.resource.data, dateId);
      allow update: if isValidVisitorDateId(dateId) && (
        isAdmin() ||
        isValidVisitorStatIncrement(request.resource.data, resource.data, dateId)
      );
      allow delete: if isValidVisitorDateId(dateId) && isAdmin();
    }
  }
}
